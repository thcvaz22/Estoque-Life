CLOUD_MODE=true
CLOUD_PERSISTENCE_MODE=neon-primary

# Neon PostgreSQL — fonte persistente/autoritativa da v17
DATABASE_URL=
NEON_POOL_MAX=5
NEON_RETRY_MS=5000

# No Render Free o filesystem é efêmero; backups SQLite locais ficam desativados.
# A persistência operacional é o Neon.
DISABLE_AUTO_DB_BACKUP=true

# Assinatura de sessão. No render.yaml o Render gera automaticamente.
AUTH_SIGNING_SECRET=

# AION IA externa
AION_EXTERNAL_AI_ENABLED=true
AION_WEB_SEARCH_ENABLED=true
AION_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Primeiro acesso em banco novo na nuvem
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Fiscal — deixe manual enquanto o emissor não estiver homologado.
FISCAL_PROVIDER=manual
# Para futura integração Focus NFe, configure no Render (nunca no GitHub):
# FISCAL_PROVIDER=focusnfe
# FOCUS_NFE_TOKEN=
# FISCAL_ENVIRONMENT=homologacao
