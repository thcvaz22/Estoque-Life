CLOUD_MODE=true
PUBLIC_BASE_URL=https://SEU-ENDERECO.onrender.com
FISCAL_PROVIDER=manual

# Banco principal PostgreSQL Neon
DATABASE_URL=
NEON_POOL_MAX=10

# Durante a migração, informe o SQLite atual se necessário
# SQLITE_SOURCE_PATH=C:\\caminho\\lifesucos.db

# AION IA externa
AION_EXTERNAL_AI_ENABLED=true
AION_WEB_SEARCH_ENABLED=true
AION_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Primeiro acesso em banco novo
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
